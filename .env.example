# XHere local environment. Placeholders only.
# Copy to .env (gitignored) when a value exists. Never commit real secrets.
# Cloudflare and the other accounts in PLAN section 8 still need Steven's OK.
# The Supabase project exists: ref jpeuldzegtbqfezijhuy, us-east-1.
# See supabase/README.md. Do not paste key values into this file.

# Supabase. Keep these placeholder strings in git so local builds stay on
# the in-memory / fixture path. In a gitignored .env or local.properties,
# SUPABASE_URL is https://jpeuldzegtbqfezijhuy.supabase.co and
# SUPABASE_ANON_KEY is the publishable key (it starts with sb_publishable_).
# The variable name stays SUPABASE_ANON_KEY. The legacy anon JWT is a
# fallback only. Never put the service-role or secret key here or in the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Astro exposes PUBLIC_ variables to the browser. Same rule: the value of
# PUBLIC_SUPABASE_ANON_KEY is the publishable sb_publishable_ key, not a
# committed secret. Leave the placeholders in this file.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_SITE_URL=https://xhere.world

# Maps use MapLibre + OpenFreeMap and do not need a key.
# Do not add a Google Maps API key here.

# Android (M3). The app reads local.properties first, then this file if you
# copy it to .env, then the environment. Only these three keys are compiled
# into BuildConfig. SUPABASE_SERVICE_ROLE_KEY is never read by the app.
# GOOGLE_WEB_CLIENT_ID is the OAuth web client id for Credential Manager.
# It is not a secret, but it is account-specific. Leave the placeholder
# until Steven approves a free Google Cloud OAuth client (PLAN §8).
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Crash reporting (M9). Leave this blank. The app does not start Sentry unless
# the value is a real DSN (https://…). Creating a Sentry account needs Steven's
# OK (docs/PLAN.md section 8). CI does not set it. Do not paste a real DSN here.
SENTRY_DSN=

# Release signing (M9). The keystore never goes in git. CI reads these from
# GitHub Actions secrets and writes the keystore to android/keystore/release.jks
# (gitignored) before Gradle runs. When any of them is missing, the release
# AAB is debug-signed so the build still succeeds. Exact secret names:
#   ANDROID_KEYSTORE_BASE64
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
# Local builds can point ANDROID_KEYSTORE_FILE at a .jks outside the repo
# instead of ANDROID_KEYSTORE_BASE64. See docs/PLAY-RELEASE.md.
# ANDROID_KEYSTORE_FILE=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=

# Optional overrides for the Play version (docs/PLAY-RELEASE.md).
# Defaults are versionName 0.9.0 and versionCode 900.
# XHERE_VERSION_NAME=0.9.0
# XHERE_VERSION_CODE=900
