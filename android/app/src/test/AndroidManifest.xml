<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- CameraX and ML Kit register a startup provider. Robolectric has no camera,
         and initializing it crashes the unit tests. The fakes never touch those classes. -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            tools:node="remove" />
        <!-- Sentry's provider is a no-op in production (auto-init is false). Unit tests remove it. -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            tools:node="remove" />
    </application>
</manifest>
