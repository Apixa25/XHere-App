---
import Base from "../layouts/Base.astro";

const description = "That XHere page does not exist.";
---

<Base title="Page not found" description={description}>
  <h1>Page not found</h1>
  <p>That address is not part of this site. Place links live under /d/ and show a teaser, never the hidden text.</p>
  <p><a class="button" href="/">Back to XHere</a></p>
</Base>
